#!/opt/bin/sh
export PATH=/opt/bin:/opt/sbin:/bin:/sbin:/usr/bin:/usr/sbin

RCI="http://127.0.0.1:79/rci"

echo "Content-Type: application/json"
echo "Access-Control-Allow-Origin: *"
echo ""

CMD=""; ARG=""; ARG2=""
if [ -n "$QUERY_STRING" ]; then
  for pair in $(echo "$QUERY_STRING" | tr '&' ' '); do
    k="${pair%%=*}"; v="${pair#*=}"
    case "$k" in
      cmd)  CMD="$v" ;;
      arg)  ARG=$(printf '%b' "${v//%/\\x}") ;;
      arg2) ARG2=$(printf '%b' "${v//%/\\x}") ;;
    esac
  done
fi

rci_post() {
  curl -s -X POST "$RCI/" \
    -H "Content-Type: application/json" \
    --data-binary "$1" 2>&1
}

rci_show() {
  local path="$1"
  local json
  json=$(python3 -c '
import sys, json
parts = [p for p in sys.argv[1].split("/") if p]
d = {}; cur = d
for p in parts[:-1]:
    cur[p] = {}; cur = cur[p]
cur[parts[-1]] = {}
print(json.dumps([{"show": d}], ensure_ascii=False))
' "$path")
  rci_post "$json"
}

rci_cmd() {
  local cmd
  cmd=$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')
  rci_post "[{\"parse\":\"$cmd\"}]"
}

rci_save() {
  rci_post '[{"parse":"system configuration save"}]' >/dev/null 2>&1
}

case "$CMD" in
  # ---------- read ----------
  version)        rci_show "version" ;;
  system)         rci_show "system" ;;
  interfaces)     rci_show "interface" ;;
  clients)        rci_show "ip/hotspot/host" ;;
  dhcp)           rci_show "ip/dhcp/pool" ;;
  usb)            rci_show "usb" ;;
  dns)            rci_show "ip/name-server" ;;
  processes)      rci_show "processes" ;;
  running-config) rci_cmd "show running-config" ;;

  # ---------- write ----------
  reboot)         rci_cmd "system reboot" ;;
  shutdown)       rci_cmd "system shutdown" ;;
  save)           rci_save; echo '{"status":"ok"}' ;;

  # ---------- произвольный RCI ----------
  rci)            rci_cmd "$ARG" ;;

  *)  echo '{"error":"unknown cmd","cmd":"'"$CMD"'"}' ;;
esac
